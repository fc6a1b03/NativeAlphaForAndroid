        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
    </style>

    <!-- Android 12+ 系统 SplashScreen：品牌色背景 + 透明图标 -->
    <style name="AppTheme.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/webnative_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme.WebView">
    </style>

    <!-- 强制深色模式主题：固定深色色板（不依赖 values-night 自动解析） -->
    <style name="AppThemeDark" parent="Theme.Material3.Dark.NoActionBar">
