<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 本地网络权限（Android 17 / API 37）：target ≥37 的应用访问私网/localhost
         默认被系统拦截，WebView 流量继承宿主权限状态——用户添加 NAS/homelab
         等局域网站点是本应用核心场景。低版本设备声明无害；运行时按需场景化
         请求（添加私网站点时/错误页引导），非启动即弹（XR1 权限最小化） -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- 网页事件通知（P5）：按需场景化请求（保存首条 notify 规则时），非启动即弹 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 8+ 安装 APK 更新需要该权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 文件选择期间前台保活（防 LMK 在选图时杀进程致 filePathCallback 丢失） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!-- WebView 相机/录音授权给站点（可选硬件，不强制要求设备有摄像头） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing"
        android:value="false" />

    <application
        android:name="com.cylonid.nativealpha.util.App"
        android:allowBackup="true"
        android:icon="@mipmap/webnative"        android:label="@string/app_name"

        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <activity
            android:name="com.cylonid.nativealpha.MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 站点分享深链（C-分享）：系统相机扫码/点击 webnative://add 唤起；
                 安全校验收口在 SiteShareCodec（fail-closed），manifest 只声明形态 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="webnative" android:host="add" />
            </intent-filter>
            <!-- 域名路由接管（默认浏览器）：声明处理 http/https 链接——用户设为
                 默认浏览器或点击时选「总是」后，邮件/笔记/其他浏览器的链接进入
                 本应用按域名路由（DomainRouter）：命中已注册 WebApp 在其内打开
                 （保留完整路径），未命中瞬态浏览（浏览器兜底角色）。
                 不带 autoVerify（无 assetlinks.json 依赖，未验证链接路径——
                 per-app「总是」授权，无需逐域校验）；判定收口在 DomainRouter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

<!--        Make sure to also copy changes to WebViewActivity in build.gradle-->
        <activity
            android:name=".ScanCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".WebViewActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/webnative"
    
            android:theme="@style/AppTheme.WebView"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            />

        <!-- 多窗矩阵（P4）：configChanges 与宿主 WebViewActivity 同口径（Q6 重建防护） -->
        <activity
            android:name=".matrix.MatrixActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
            android:launchMode="standard"
            />

        <!-- 网页事件规则编辑器（P5） -->
        <activity
            android:name=".webevent.RuleEditorActivity"
            android:parentActivityName=".WebAppSettingsActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="standard"
            />

        <activity
            android:name="com.cylonid.nativealpha.SettingsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/webnative"
    
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="com.cylonid.nativealpha.WebAppSettingsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/webnative"
    
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="com.cylonid.nativealpha.StatsReviewActivity"
            android:parentActivityName=".WebAppStatsActivity"
            android:theme="@style/AppTheme"
            android:exported="false">
        </activity>
        <activity
            android:name="com.cylonid.nativealpha.WebAppStatsActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/webnative"
    
            android:theme="@style/AppTheme"
            android:exported="false">
        </activity>

        <activity
            android:name="com.cylonid.nativealpha.ui.AddWebAppActivity"
            android:parentActivityName=".MainActivity"
            android:icon="@mipmap/webnative"
    
            android:theme="@style/AppTheme"
            android:exported="false">
        </activity>


        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true"/>
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true"/>
        <!--        https://developer.samsung.com/samsung-dex/modify-optimizing.html-->

        <!-- 版本更新 APK 安装：FileProvider（Android 8+ 安装需要 content:// URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 版本更新 APK 下载完成广播：DownloadManager 通知后自动触发安装 -->
        <receiver
            android:name="com.cylonid.nativealpha.util.UpdateChecker$DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- 文件选择期间前台保活：选择结束即停，非常驻 -->
        <service
            android:name="com.cylonid.nativealpha.util.ChooserKeepAlive"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>